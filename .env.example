# Piton Environment Variables (Optional — CLI scan/init/lock require zero env vars)

# Required in `mode: enforce` for HMAC-chained decision ledgers & MRTR approval tokens (32+ bytes)
PITON_LEDGER_SIGNING_KEY=replace-with-32-byte-random-hex-key

# Optional key for deterministic PII tokenization (`alice@acme.com` -> `tok_8f1a2b3c@acme.com`)
PITON_TOKENIZER_KEY=replace-with-32-byte-random-hex-key

# Optional Control Plane settings (`piton control-plane`)
PITON_CONTROL_API_KEY=
PITON_SLACK_WEBHOOK_URL=
PITON_SLACK_SIGNING_SECRET=
